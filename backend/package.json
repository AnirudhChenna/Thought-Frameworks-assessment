{
  "name": "support-ticket-backend",
  "version": "1.0.0",
  "description": "REST API Backend for Support Ticket Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --detectOpenHandles --runInBand",
    "db:init": "node src/scripts/initDb.js",
    "db:seed": "node src/scripts/seedDb.js"
  },
  "keywords": [
    "ticket",
    "support",
    "express",
    "mysql",
    "jwt",
    "api"
  ],
  "author": "Assessment Candidate",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.10.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
